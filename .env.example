# Web app: single long-lived instance only; public ingress must enforce body/time limits.
DEPLOYMENT_MODE=single-instance
APP_ORIGIN=http://localhost:3000
# Default false pools anonymous users safely. Enable only behind ingress that overwrites x-real-ip.
TRUST_PROXY=false

# Server-only OpenAI-compatible DeepSeek configuration. Select a current available model explicitly.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
# Enable only after provider:verify confirms the selected model accepts images.
DEEPSEEK_SUPPORTS_VISION=false

# Internal scanner control endpoint. Never publish the worker/proxy/debug ports to the internet.
SCANNER_URL=http://127.0.0.1:8787
# Generate a cryptographically random value, at least 32 bytes, and share only with web/worker.
SCANNER_TOKEN=
