# Web app: single long-lived instance only; public ingress must enforce body/time limits.
DEPLOYMENT_MODE=single-instance
APP_ORIGIN=http://localhost:3000
# Default false pools anonymous users safely. Enable only behind ingress that overwrites x-real-ip.
TRUST_PROXY=false

# Server-only OpenAI-compatible DeepSeek configuration. Select a current available model explicitly.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
# Enable only after provider:verify confirms the selected model accepts images.
DEEPSEEK_SUPPORTS_VISION=false

# Internal scanner control endpoint. Never publish the worker/proxy/debug ports to the internet.
SCANNER_URL=http://127.0.0.1:8787
# Generate a cryptographically random value, at least 32 bytes, and share only with web/worker.
SCANNER_TOKEN=

# Optional: GitHub personal access token (classic or fine-grained) for higher GitHub API rate limits.
# Without a token, GitHub limits unauthenticated requests to 60/hr per IP. With a token, limits increase to 5,000/hr.
GITHUB_TOKEN=

# Optional members-only Hall: identity login via Supabase. Scanning stays public.
# Copy values from your Supabase project. Never use a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact trusted browser origin; align with Supabase callback allowlist.
AUTH_SITE_URL=http://localhost:3000
# Provider client secrets belong in Supabase settings, NOT in this file.
