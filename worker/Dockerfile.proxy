FROM node:22-bookworm-slim
ENV NODE_ENV=production PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 HOME=/tmp
WORKDIR /app
RUN npm install --global pnpm@12.3.4 --ignore-scripts
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --prod --frozen-lockfile --ignore-scripts
COPY lib/security ./lib/security
COPY lib/types ./lib/types
COPY worker ./worker
USER 1000:1000
CMD ["node", "--import", "tsx", "worker/start.ts", "proxy"]
